# SmartFlow AI Environment Configuration
# Copy this file to .env and adjust variables as required.

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# AI Model Settings
YOLO_MODEL_PATH=backend/models/yolov8n.pt
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_ROAD_CAPACITY=35

# Signal Timing Parameters (Seconds)
MIN_GREEN_SECONDS=15
MAX_GREEN_SECONDS=60
YELLOW_SECONDS=3
ALL_RED_SECONDS=2
FIXED_BASELINE_GREEN=30

# Emergency Priority Settings
DEFAULT_EMERGENCY_JUNCTION=J2
HOSPITAL_DESTINATION_JUNCTION=J3
